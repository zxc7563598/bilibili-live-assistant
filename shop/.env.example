# 商城前端环境变量
VITE_APP_NAME=积分商城

# 后端 API 地址
# 留空表示同源：前端请求直接跟随当前访问地址。后端把商城挂在 /shop/ 下，
# 同源访问不会出问题，换域名、换端口、http/https 都不用重新构建。
# 只有当前端和后端不在同一个地址下时才需要填绝对地址，例如 'https://api.example.com'
VITE_API_URL=''

# HMAC 签名密钥：必须与后端 config.yaml 的 crypto.sign_secret 严格一致！
# 不一致会导致后端验签失败，所有加密请求返回 10009。
# 后端 config.yaml 中 sign_secret 可在首次运行自动生成的默认配置中查看，或自行指定后保持两边相同。
VITE_SIGN_SECRET='替换为与后端 crypto.sign_secret 一致的密钥'
