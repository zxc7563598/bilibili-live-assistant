# 后台管理前端环境变量
VITE_TITLE = '后台管理系统'

# 是否使用Hash路由
VITE_USE_HASH = 'false'

# 资源公共路径,需要以 /开头和结尾
VITE_PUBLIC_PATH = '/admin/'

# 后端 API 地址
# 留空表示同源：前端请求直接跟随当前访问地址。后端把商城挂在 /shop/ 下，
# 同源访问不会出问题，换域名、换端口、http/https 都不用重新构建。
# 只有当前端和后端不在同一个地址下时才需要填绝对地址，例如 'https://api.example.com'
VITE_AXIOS_BASE_URL = ''
VITE_PROXY_TARGET = ''
