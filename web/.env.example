# 后台管理前端环境变量
VITE_TITLE = '后台管理系统'

# 是否使用Hash路由
VITE_USE_HASH = 'false'

# 资源公共路径,需要以 /开头和结尾
VITE_PUBLIC_PATH = '/admin/'

# 后端 API 地址
# 留空表示同源：前端请求直接跟随当前访问地址。后端把商城挂在 /shop/ 下，
# 同源访问不会出问题，换域名、换端口、http/https 都不用重新构建。
# 只有当前端和后端不在同一个地址下时才需要填绝对地址，例如 'https://api.example.com'
VITE_AXIOS_BASE_URL = ''
VITE_PROXY_TARGET = ''

# 请求加密 HMAC 签名密钥：必须与后端 config.yaml 的 crypto.sign_secret 严格一致！
# 不一致会导致公钥验签失败、所有加密请求被拒（10009），后台将无法登录。
# 留空表示不加密（明文发送）。商城端 shop/.env 要用同一个值。
VITE_SIGN_SECRET = '替换为与后端 crypto.sign_secret 一致的密钥'
